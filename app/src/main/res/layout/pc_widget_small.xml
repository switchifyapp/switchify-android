<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pc_widget_first"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pc_widget_button_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="4dp">

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_pc_widget_desktop"
        android:tint="@color/pc_widget_on_highlight" />

    <TextView
        android:id="@+id/pc_widget_first_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/pc_widget_on_highlight"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
