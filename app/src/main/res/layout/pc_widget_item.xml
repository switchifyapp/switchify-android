<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pc_widget_item"
    android:layout_width="match_parent"
    android:layout_height="42dp"
    android:paddingTop="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/pc_widget_item_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="10dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/pc_widget_icon_background"
            android:importantForAccessibility="no"
            android:padding="6dp"
            android:src="@drawable/ic_pc_widget_desktop"
            android:tint="@color/pc_widget_on_surface" />

        <TextView
            android:id="@+id/pc_widget_item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/pc_widget_on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pc_widget_item_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:textColor="@color/pc_widget_on_surface_variant"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
