<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for API 31+.
   The Supabase session (access + refresh tokens) lives in the default shared
   preferences file and must never leave the device. RevenueCat caches are
   rebuilt from the network and are excluded to keep the backup small.
   PC pairing metadata, the PC device ID and Keystore-encrypted pairing tokens
   must stay on this device, as must the plain-text PC pairing stores left by
   versions before 3.1.0.
   The tips opt-in and the Firebase registration belong to one device: a
   restored device must be opted in again and must not reuse another
   device's Firebase installation. The installation file name is derived
   from the Firebase app ID of the official build.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="com.enaboapps.switchify_preferences.xml" />
        <exclude domain="device_sharedpref" path="com.enaboapps.switchify_preferences.xml" />
        <exclude domain="sharedpref" path="com_revenuecat_purchases_preferences.xml" />
        <exclude domain="device_sharedpref" path="com_revenuecat_purchases_preferences.xml" />
        <exclude domain="sharedpref" path="com_revenuecat_purchases_com.enaboapps.switchify_preferences_diagnostics.xml" />
        <exclude domain="device_sharedpref" path="com_revenuecat_purchases_com.enaboapps.switchify_preferences_diagnostics.xml" />
        <exclude domain="sharedpref" path="com.enaboapps.switchify_preferences_etags_v2.xml" />
        <exclude domain="device_sharedpref" path="com.enaboapps.switchify_preferences_etags_v2.xml" />
        <exclude domain="file" path="RevenueCat" />
        <exclude domain="device_file" path="RevenueCat" />
        <exclude domain="file" path="switchify_pc" />
        <exclude domain="device_file" path="switchify_pc" />
        <exclude domain="sharedpref" path="switchify_pc_pairings.xml" />
        <exclude domain="device_sharedpref" path="switchify_pc_pairings.xml" />
        <exclude domain="sharedpref" path="pc_switch_forwarding_profiles.xml" />
        <exclude domain="device_sharedpref" path="pc_switch_forwarding_profiles.xml" />
        <exclude domain="sharedpref" path="tip_notifications.xml" />
        <exclude domain="device_sharedpref" path="tip_notifications.xml" />
        <exclude domain="sharedpref" path="com.google.android.gms.appid.xml" />
        <exclude domain="device_sharedpref" path="com.google.android.gms.appid.xml" />
        <exclude domain="sharedpref" path="com.google.firebase.messaging.xml" />
        <exclude domain="device_sharedpref" path="com.google.firebase.messaging.xml" />
        <exclude domain="file" path="datastore/com.google.android.gms.appid.preferences_pb" />
        <exclude domain="device_file" path="datastore/com.google.android.gms.appid.preferences_pb" />
        <exclude domain="file" path="PersistedInstallation.W0RFRkFVTFRd+MToyODk5NTQ4NTI0NTk6YW5kcm9pZDpiZDc1ZTAzMjRlOGEwNmJjZDU0YjJl.json" />
        <exclude domain="device_file" path="PersistedInstallation.W0RFRkFVTFRd+MToyODk5NTQ4NTI0NTk6YW5kcm9pZDpiZDc1ZTAzMjRlOGEwNmJjZDU0YjJl.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="com.enaboapps.switchify_preferences.xml" />
        <exclude domain="device_sharedpref" path="com.enaboapps.switchify_preferences.xml" />
        <exclude domain="sharedpref" path="com_revenuecat_purchases_preferences.xml" />
        <exclude domain="device_sharedpref" path="com_revenuecat_purchases_preferences.xml" />
        <exclude domain="sharedpref" path="com_revenuecat_purchases_com.enaboapps.switchify_preferences_diagnostics.xml" />
        <exclude domain="device_sharedpref" path="com_revenuecat_purchases_com.enaboapps.switchify_preferences_diagnostics.xml" />
        <exclude domain="sharedpref" path="com.enaboapps.switchify_preferences_etags_v2.xml" />
        <exclude domain="device_sharedpref" path="com.enaboapps.switchify_preferences_etags_v2.xml" />
        <exclude domain="file" path="RevenueCat" />
        <exclude domain="device_file" path="RevenueCat" />
        <exclude domain="file" path="switchify_pc" />
        <exclude domain="device_file" path="switchify_pc" />
        <exclude domain="sharedpref" path="switchify_pc_pairings.xml" />
        <exclude domain="device_sharedpref" path="switchify_pc_pairings.xml" />
        <exclude domain="sharedpref" path="pc_switch_forwarding_profiles.xml" />
        <exclude domain="device_sharedpref" path="pc_switch_forwarding_profiles.xml" />
        <exclude domain="sharedpref" path="tip_notifications.xml" />
        <exclude domain="device_sharedpref" path="tip_notifications.xml" />
        <exclude domain="sharedpref" path="com.google.android.gms.appid.xml" />
        <exclude domain="device_sharedpref" path="com.google.android.gms.appid.xml" />
        <exclude domain="sharedpref" path="com.google.firebase.messaging.xml" />
        <exclude domain="device_sharedpref" path="com.google.firebase.messaging.xml" />
        <exclude domain="file" path="datastore/com.google.android.gms.appid.preferences_pb" />
        <exclude domain="device_file" path="datastore/com.google.android.gms.appid.preferences_pb" />
        <exclude domain="file" path="PersistedInstallation.W0RFRkFVTFRd+MToyODk5NTQ4NTI0NTk6YW5kcm9pZDpiZDc1ZTAzMjRlOGEwNmJjZDU0YjJl.json" />
        <exclude domain="device_file" path="PersistedInstallation.W0RFRkFVTFRd+MToyODk5NTQ4NTI0NTk6YW5kcm9pZDpiZDc1ZTAzMjRlOGEwNmJjZDU0YjJl.json" />
    </device-transfer>
</data-extraction-rules>
